# Copy to .env and fill in from the Stripe sandbox dashboard. NEVER commit .env.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Populated by later scripts as they create objects:
SPIKE_PRICE_ID=
SPIKE_CONNECTED_ACCOUNT_ID=
SPIKE_PAYMENT_INTENT_ID=
SPIKE_CHARGE_ID=
# Increment deliberately only when creating a new proof object/session; retries keep the same value.
SPIKE_ATTEMPT=1
# Operator-only value printed by `stripe listen`; never paste it into an agent transcript.
SPIKE_WEBHOOK_SIGNING_SECRET=
