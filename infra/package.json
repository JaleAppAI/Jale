{
  "name": "infra",
  "version": "0.1.0",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "postinstall": "node scripts/patch-cdk-brace-expansion.mjs",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --maxWorkers=2",
    "test:ci": "jest",
    "cdk": "cdk",
    "deploy": "npm run test && npx cdk deploy",
    "test:integration": "jest --config jest.integration.config.js",
    "test:whatsapp-v2": "jest test/unit/lambda/whatsapp/onboarding-v2.test.ts test/unit/lambda/whatsapp/onboarding-v2-profile.test.ts test/unit/lambda/whatsapp/onboarding-v2-conversation.test.ts test/unit/lambda/whatsapp/processor.test.ts test/unit/lambda/whatsapp/lib/onboarding-language.test.ts test/unit/lambda/whatsapp/lib/onboarding-renderers.test.ts test/unit/lambda/whatsapp/lib/onboarding-adapters.test.ts --runInBand",
    "test:whatsapp-v2-db": "bash scripts/run-whatsapp-v2-db-tests.sh",
    "test:wage-reference-db": "bash scripts/run-wage-reference-db-tests.sh",
    "generate:oews-seed": "tsx scripts/generate-oews-seed.ts",
    "seed:oews-wages": "tsx scripts/seed-oews-wages.ts",
    "reset:whatsapp-v2": "tsx scripts/reset-whatsapp-onboarding-v2.ts",
    "whatsapp:controls": "tsx scripts/whatsapp-runtime-controls.ts",
    "replay:whatsapp-domain-event": "tsx scripts/replay-domain-event.ts",
    "replay:whatsapp-inbound": "tsx scripts/replay-whatsapp-inbound.ts",
    "redrive:billing-dlq": "tsx scripts/redrive-billing-dlq.ts",
    "reextract:trust": "tsx scripts/reextract-trust.ts",
    "export:csv": "tsx scripts/export-db-to-csv.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "aws-cdk": "^2.1141.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1129.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1129.0",
    "@aws-sdk/client-dynamodb": "^3.1129.0",
    "@aws-sdk/client-lambda": "^3.1129.0",
    "@aws-sdk/client-rekognition": "^3.1129.0",
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/client-secrets-manager": "^3.1129.0",
    "@aws-sdk/client-sesv2": "^3.1129.0",
    "@aws-sdk/client-sfn": "^3.1129.0",
    "@aws-sdk/client-sqs": "^3.1129.0",
    "@aws-sdk/client-ssm": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "pg": "^8.23.0",
    "stripe": "22.3.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
