{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:policy": "node scripts/check-action-policy.mjs && node scripts/check-report-policy.mjs",
    "test:server-db": "node scripts/check-server-db-helpers.mjs && node scripts/check-audit-record.mjs",
    "test:session": "node scripts/check-session-helpers.mjs && node scripts/check-audit-session.mjs && node scripts/check-proxy.mjs && node scripts/check-device-trust.mjs",
    "test:session-store": "node scripts/check-admin-session-store.mjs",
    "test:read-models": "node scripts/check-read-models.mjs && node scripts/check-audit-loaders.mjs && node scripts/check-inbox.mjs",
    "test:analytics": "node scripts/check-analytics-helpers.mjs",
    "test:charts": "node scripts/check-chart-geometry.mjs",
    "test:dispatch": "node scripts/check-action-dispatch.mjs && node scripts/check-report-actions.mjs && node scripts/check-audit-actions.mjs && node scripts/check-admin-users.mjs",
    "test:safe-redirect": "node scripts/check-safe-redirect.mjs",
    "test:ui": "node scripts/run-ui-checks.mjs",
    "test:mfa": "node scripts/check-mfa-setup.mjs",
    "test:report-db": "node scripts/check-report-db.mjs",
    "test:audit-db": "node scripts/check-audit-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.1130.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1130.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1130.0",
    "@aws-sdk/client-s3": "3.1130.0",
    "@aws-sdk/client-secrets-manager": "^3.1129.0",
    "@aws-sdk/client-sqs": "3.1130.0",
    "@aws-sdk/s3-request-presigner": "3.1130.0",
    "amazon-cognito-identity-js": "^6.3.20",
    "aws-jwt-verify": "^5.2.1",
    "lucide-react": "1.44.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
